{
    "$schema": "https://schemas.wp.org/trunk/wp-env.json",
    "core": "WordPress/WordPress#6.8",
    "phpVersion": "7.4",
    "plugins": [
        "../../plugins/design-system-wordpress-plugin",
        "../../plugins/wordpress-document-repository",
        "../../plugins/wordpress-search"
    ],
    "mappings": {
        "./afterStart.sh": "wp-content/afterStart.sh"
    },
    "themes": [
        "bcgov/design-system-wordpress-child-theme-hporoo",
        "../design-system-wordpress-theme"
    ],
    "config": {
        "WP_DEBUG_DISPLAY": true,
        "WP_SITEURL": "http://127.0.0.1:8888",
        "WP_HOME": "http://127.0.0.1:8888"
    },
    "lifecycleScripts": {
        "afterStart": "wp-env run cli sh /var/www/html/wp-content/afterStart.sh && wp-env run tests-cli sh /var/www/html/wp-content/afterStart.sh"
    }
}
